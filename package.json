{
  "name": "small-rabbit-editor",
  "version": "0.6.0",
  "description": "小野兔 Rabbit — 轻量化 AI 辅助 Markdown 编辑器",
  "main": "main.js",
  "scripts": {
    "build:renderer": "esbuild renderer/js/app.js --bundle --outfile=renderer/bundle.js --platform=browser --format=iife",
    "build:icons": "electron scripts/generate-brand-assets.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "npm run build:renderer && electron .",
    "pack": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language-data": "^6.5.1",
    "codemirror": "^6.0.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.0",
    "marked": "^15.0.0"
  },
  "build": {
    "appId": "com.small-rabbit.editor",
    "productName": "小野兔 Rabbit",
    "directories": {
      "output": "dist-pkg"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "renderer/assets/icon.png",
      "category": "Office"
    }
  }
}
